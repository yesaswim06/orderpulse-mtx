{
  "buildCommand": "node scripts/build-vercel.js",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://orderpulse-mtx.up.railway.app/api/$1"
    },
    {
      "source": "/ws",
      "destination": "https://orderpulse-mtx.up.railway.app/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
