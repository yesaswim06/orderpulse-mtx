# Ultra-Low Latency Order-Book Matching Engine with Volatility Circuit Breakers
# Configuration environment template

# Application Ports
PORT=8080
FRONTEND_PORT=3000

# Symbol configuration
SYMBOL=DEMO
TICK_SIZE_RUPEES=0.01

# Circuit Breaker Demo Policy (Demonstration settings, not official exchange rules)
BREAKER_REFERENCE_PRICE_RUPEES=100.00
BREAKER_BAND_PERCENT=5.0
BREAKER_HALT_DURATION_SECONDS=30

# Security (DEMO ADMIN TOKEN - Never expose to frontend bundles)
DEMO_ADMIN_TOKEN=demo-admin-secret-mtx-2026

# Database configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orderpulse_mtx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_mtx

# Persistence mode: memory | postgres
PERSISTENCE_MODE=memory
